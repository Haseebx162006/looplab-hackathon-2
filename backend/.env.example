# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration (Direct credentials)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loop_hack_db
DB_USER=postgres
DB_PASSWORD=postgres

# Alternatively, connection URI (recommended for Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:6543/postgres?sslmode=require


# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Gmail API Configuration
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
GMAIL_USER_EMAIL=your_gmail_email_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

